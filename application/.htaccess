# À n'utiliser que si l'hébergeur ne permet pas de faire pointer le sous-domaine sur le dossier public/.
# Bloque l'accès direct au code, à la configuration et aux fichiers déposés, et renvoie tout vers public/.
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(app|storage|outils|tests)(/|$) - [F,L]
  RewriteRule ^(README\.md|\.git.*)$ - [F,L]
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
